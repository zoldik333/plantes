{
  "name": "plantes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "pnpm --filter @plantes/api start",
    "dev": "pnpm --filter @plantes/api dev",
    "typecheck": "pnpm -r typecheck",
    "test:ai": "pnpm --filter @plantes/api test:ai",
    "ai:ping": "pnpm --filter @plantes/api ai:ping",
    "vapid": "pnpm --filter @plantes/api vapid",
    "test": "pnpm --filter @plantes/tests test",
    "test:ui": "pnpm --filter @plantes/web build && pnpm --filter @plantes/tests test:ui"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "^0.25.12"
    }
  }
}
