# --- IA ---------------------------------------------------------------
# Token de ton abonnement Claude : lance `claude setup-token` sur un poste avec navigateur.
CLAUDE_CODE_OAUTH_TOKEN=
# Jour de création du jeton ci-dessus (AAAA-MM-JJ). Le jeton `claude setup-token` dure UN AN et aucune date n'est lisible :
# l'appli s'en sert pour prévenir (notification + bandeau) à 30, 14, 7, 3 et 1 jours de l'expiration.
# Renseignée automatiquement par `./scripts/rotate-token.sh`. Vide = pas d'alerte d'expiration.
CLAUDE_TOKEN_CREATED=
# NE PAS définir ANTHROPIC_API_KEY (elle prendrait le dessus et facturerait l'API).
AI_PROVIDER=claude-agent-sdk
AI_MODEL=sonnet
AI_DEBUG=0

# --- Push (générées par `docker compose run --rm app npm run vapid`) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Apple refuse les subjects invalides : mets un vrai mailto.
VAPID_SUBJECT=mailto:toi@example.com

# --- Accès ------------------------------------------------------------
# Clé partagée demandée par la page (12 caractères min) : `openssl rand -hex 16`
POC_ACCESS_KEY=

# --- Authentification --------------------------------------------------
# URL publique de l'app, sans slash final. Le rpID des passkeys en dérive : ne la change pas après coup
# (les passkeys déjà créées ne marcheraient plus).
APP_URL=https://plantes.tvermorel.fr
# Secret de signature des sessions : `openssl rand -base64 32`. Obligatoire en production.
BETTER_AUTH_SECRET=

# --- Rappels d'arrosage -------------------------------------------------
# Heures (Paris) des rappels : la première est le rappel du jour, les suivantes des relances envoyées
# seulement s'il reste des plantes à arroser. Vide = rappels désactivés. Par défaut : 9,18.
REMINDER_HOURS=9,18

# --- Surveillance (facultatif) ------------------------------------------
# URL de ping d'un service de surveillance (ex. healthchecks.io, gratuit : créer un « check » de période 10 minutes,
# copier son URL de ping ici). Le serveur l'appelle toutes les 5 minutes tant que son planificateur tourne et que la
# base répond ; si les appels s'arrêtent, le service t'envoie une alerte. Vide = désactivé.
HEARTBEAT_URL=
